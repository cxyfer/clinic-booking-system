{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "clinic-booking-system",
	"main": "src/worker/index.ts",
	"compatibility_date": "2026-11-01",
	"observability": { "enabled": true },
	"assets": {
		// SPA：非 /api 路徑交給前端 router 處理
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "clinic-booking",
			// 首次 deploy 時 wrangler 會自動建立資料庫並回填 database_id
			"migrations_dir": "migrations"
		}
	],
	"triggers": {
		// 通知重試、pending／未驗證預約逾時、提醒信
		"crons": ["*/5 * * * *"]
	},
	"vars": {
		"APP_URL": "http://localhost:5173",
		// resend | console | none
		"EMAIL_PROVIDER": "console",
		"EMAIL_FROM": "Clinic <no-reply@example.com>",
		// 留空則停用 webhook
		"WEBHOOK_URL": ""
	}
	// Secrets（以 `wrangler secret put` 設定，本地放 .dev.vars）：
	// RESEND_API_KEY, WEBHOOK_SECRET, TURNSTILE_SECRET_KEY
}
